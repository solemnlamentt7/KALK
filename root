<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Super Smart Calculator</title>
  <style>
    * {
      box-sizing: border-box;
      font-family: 'Segoe UI', sans-serif;
    }

    body {
      background: linear-gradient(145deg, #1e1e2f, #111120);
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .calculator {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      padding: 20px;
      border-radius: 20px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
      width: 100%;
      max-width: 400px;
    }

    .display {
      width: 100%;
      height: 70px;
      border-radius: 12px;
      background: #0f172a;
      color: #f8fafc;
      font-size: 28px;
      text-align: right;
      padding: 10px;
      margin-bottom: 20px;
      border: none;
    }

    .buttons {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
    }

    button {
      padding: 18px;
      font-size: 18px;
      border: none;
      border-radius: 14px;
      background: #1e293b;
      color: #ffffff;
      cursor: pointer;
      font-weight: bold;
      transition: 0.2s ease;
    }

    button:hover {
      background: #334155;
    }

    .equal {
      background: #22c55e;
      color: white;
    }

    .equal:hover {
      background: #16a34a;
    }

    .clear {
      background: #ef4444;
    }

    .clear:hover {
      background: #dc2626;
    }

    .fn {
      background: #3b82f6;
    }

    .fn:hover {
      background: #2563eb;
    }

    @media (max-width: 480px) {
      .calculator {
        padding: 15px;
      }

      button {
        padding: 14px;
        font-size: 16px;
      }

      .display {
        font-size: 24px;
      }
    }
  </style>
</head>
<body>
  <div class="calculator">
    <input type="text" id="display" class="display" placeholder="0" readonly />
    <div class="buttons">
      <button class="fn" onclick="insert('Math.PI')">π</button>
      <button class="fn" onclick="insert('Math.E')">e</button>
      <button class="fn" onclick="insert('Math.pow(')">^</button>
      <button class="fn" onclick="insert('Math.sqrt(')">√</button>
      <button class="clear" onclick="clearDisplay()">C</button>

      <button onclick="insert('7')">7</button>
      <button onclick="insert('8')">8</button>
      <button onclick="insert('9')">9</button>
      <button onclick="insert('/')">÷</button>
      <button onclick="backspace()">⌫</button>

      <button onclick="insert('4')">4</button>
      <button onclick="insert('5')">5</button>
      <button onclick="insert('6')">6</button>
      <button onclick="insert('*')">×</button>
      <button class="fn" onclick="insert('Math.log10(')">log</button>

      <button onclick="insert('1')">1</button>
      <button onclick="insert('2')">2</button>
      <button onclick="insert('3')">3</button>
      <button onclick="insert('-')">−</button>
      <button class="fn" onclick="insert('Math.sin(')">sin</button>

      <button onclick="insert('0')">0</button>
      <button onclick="insert('.')">.</button>
      <button class="equal" onclick="calculate()">=</button>
      <button onclick="insert('+')">+</button>
      <button class="fn" onclick="insert('Math.cos(')">cos</button>

      <button class="fn" onclick="insert('Math.tan(')">tan</button>
      <button onclick="insert('(')">(</button>
      <button onclick="insert(')')">)</button>
      <button class="fn" onclick="insert('Math.log(')">ln</button>
      <button class="fn" onclick="insert('Math.abs(')">abs</button>
    </div>
  </div>

  <script>
    const display = document.getElementById("display");

    function insert(value) {
      display.value += value;
    }

    function clearDisplay() {
      display.value = "";
    }

    function backspace() {
      display.value = display.value.slice(0, -1);
    }

    function calculate() {
      try {
        let result = Function('"use strict"; return (' + display.value + ')')();
        display.value = result;
      } catch (e) {
        display.value = "Error";
      }
    }

    // Keyboard support
    document.addEventListener("keydown", function (e) {
      const allowedKeys = "0123456789+-*/().";
      if (allowedKeys.includes(e.key)) {
        insert(e.key);
      } else if (e.key === "Enter") {
        e.preventDefault();
        calculate();
      } else if (e.key === "Backspace") {
        backspace();
      } else if (e.key === "Escape") {
        clearDisplay();
      }
    });
  </script>
</body>
</html>
